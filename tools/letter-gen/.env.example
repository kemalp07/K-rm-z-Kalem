# Copy to .env and fill in. Never commit .env.
# Authentication is Application Default Credentials:
#   gcloud auth application-default login
# or point GOOGLE_APPLICATION_CREDENTIALS at a service-account key kept OUTSIDE the repo,
# or (cloud sessions) put the key's JSON itself in GOOGLE_CREDENTIALS_JSON.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEN_MODEL=
REVIEW_MODEL=

# Prices in USD per one million tokens, for the cost estimate only (0 = unknown).
# "Output" includes the model's thinking tokens.
PRICE_GEN_INPUT_PER_M=0
PRICE_GEN_OUTPUT_PER_M=0
PRICE_REVIEW_INPUT_PER_M=0
PRICE_REVIEW_OUTPUT_PER_M=0
