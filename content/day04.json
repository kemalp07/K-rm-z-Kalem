      "dateLine": "7 Mayıs 1331",
      "heading": "Rıza'ma,",
      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Bu mektubu yine İmam Efendi'ye yazdırıyorum. Evvela selam eder, gözlerinden öperim."
        },
        {
          "id": "s2",
          "kind": "sensitive",
          "text": "Marmara'da bir İngiliz tahtelbahiri dolaşıyormuş; Mudanya vapuru işlemiyor, Köprü'de herkes korku içinde."
        },
        {
          "id": "s3",
          "kind": "normal",
          "text": "Fatma artık seni sorunca kapıyı gösteriyor."
        },
        {
          "id": "s4",
          "kind": "normal",
          "text": "Hasan'ın anasına uğradım; oğlunun eli yüzü düzgün mü diye sordu, ne diyeceğimi bilemedim."
        },
        {
          "id": "s5",
          "kind": "sensitive",
          "text": "Dikimevinde ücretleri yarıya indirdiler, yine de gidiyorum."
        },
        {
          "id": "s6",
          "kind": "normal",
          "text": "Sen kendine bak, gerisi Allah'ın."
        }
      ],
      "signature": "Refikan Emine",
      "reasons": [
        "moral"
      ],
      "outcomes": [
        {
          "when": {
            "all": [
              "d4_emine:reported"
            ]
          },
          "text": "Emine'nin mektubu Şube'ye gitti. Dikimevinin ustabaşısı yine çağrılacak."
        },
        {
          "when": {
            "all": [
              "d4_emine:stopped"
            ]
          },
          "text": "Rıza bu hafta da evden haber alamayacak."
        },
        {
          "when": {
            "all": [
              "d4_emine:held"
            ]
          },
          "text": "Emine'nin sözleri bir gece daha çekmecede bekleyecek."
        },
        {
          "when": {
            "all": [
              "d4_emine:delivered"
            ],
            "none": [
              "d4_emine:censored:s2"
            ]
          },
          "text": "Tahtelbahir haberi çadırdan çadıra dolaşacak; kimse evine mektup yazmak istemeyecek."
        },
        {
          "text": "Hasan mektubu okurken karalı satırları atlayacak; Rıza bir şey sormayacak."
        }
      ]
    },
