        },
        {
          "when": {
            "all": [
              "d4_mehmet:stopped"
            ]
          },
          "text": "Hatice Hanım oğlundan haber alamayacak; Mehmet ertesi gün Seddülbahir'e gidecek."
        },
        {
          "when": {
            "all": [
              "d4_mehmet:held"
            ]
          },
          "text": "Mehmet'in mektubu bir gece daha çekmecede bekleyecek."
