      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Evvela ellerinizden öperim. Yolladığınız dutları aldım, takımda herkese birer avuç verdim."
        },
        {
          "id": "s2",
          "kind": "normal",
          "text": "Pederime selam söyleyin; bağın hesabını ona bırakıyorum, Osman'a o baksın."
        },
        {
          "id": "s3",
          "kind": "sensitive",
          "text": "Taburdan otuz kişiyi Seddülbahir tarafına aldılar, yarın biz de gidiyormuşuz."
        },
        {
          "id": "s4",
          "kind": "sensitive",
          "text": "Dün ölüleri gömmek için iki taraf da ateşi kesti; düşmanın askeri de bizimkiler gibi çocuk."
        },
        {
          "id": "s5",
          "kind": "normal",
          "text": "Ayşe'ye söyleyin, çakısını unutmadım."
        }
      ],
