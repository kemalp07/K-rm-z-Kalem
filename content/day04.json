      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Evvela selam eder, hatırınızı sorarım. Sivas'ta havalar ısındı, bağlar uyandı."
        },
        {
          "id": "s2",
          "kind": "normal",
          "text": "İncir sandıklarını aldınız mı? Fener ikinciden sonra kayıklar beklesin, biz haber veririz."
        },
        {
          "id": "s3",
          "kind": "normal",
          "text": "Validemiz ellerinizden öper, duanızı ister."
        },
        {
          "id": "s4",
          "kind": "normal",
          "text": "Cevabınızı malum adrese yollayınız."
        }
      ],
      "signature": "Amcazadeniz Hüsnü",
      "inspectables": [
        {
          "id": "postmark",
          "target": "postmark",
          "anomaly": true,
          "note": "Gönderen Sivaslı, posta damgası İZMİR. Sivas'tan yazılan mektup İzmir'de damgalanmaz."
        }
      ],
      "reasons": [
        "damga",
        "sahte",
        "gizli"
      ],
      "outcomes": [
        {
          "when": {
            "all": [
              "d4_huesnue:reported",
              "d4_huesnue:marked:postmark"
            ]
          },
          "text": "Şube İzmir postanesine yazdı. Hüsnü diye bir Sivaslı bulunamayacak; İzmir'de biri aranacak."
        },
        {
          "when": {
            "all": [
              "d4_huesnue:reported"
            ]
          },
          "text": "Mektup Şube'ye gitti, ama damganın İzmir olduğunu kimse not etmedi."
        },
        {
          "when": {
            "all": [
              "d4_huesnue:stopped"
            ]
          },
          "text": "Halil Efendi bu hafta 'amcazadesinden' haber alamayacak."
        },
        {
          "when": {
            "all": [
              "d4_huesnue:held"
            ]
          },
          "text": "Mektup bir gece daha çekmecede bekleyecek."
        },
        {
          "text": "Halil Efendi mektubu okuyup sobaya atacak. Kayıklar fener ikinciden sonra bekleyecek."
