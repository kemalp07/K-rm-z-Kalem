      "outcomes": [
        {
          "when": {
            "all": [
              "d2_kumpanya:reported",
              "d1_imzasiz:reported"
            ]
          },
          "text": "Halil Efendi'nin adı Şube'nin dosyasına ikinci kez yazıldı. Dosya kalınlaşıyor."
        },
        {
          "when": {
            "all": [
              "d2_kumpanya:reported"
            ]
          },
          "text": "Şube Galata'daki adresi arayacak. Kapıda bir kumpanya tabelası bile yok."
        },
        {
          "when": {
            "all": [
              "d2_kumpanya:stopped"
            ]
          },
          "text": "Halil Efendi bu hafta Galata'dan haber alamayacak. Bir başka yol arayacaklar."
        },
        {
          "when": {
            "all": [
              "d2_kumpanya:held"
            ]
          },
          "text": "Kumpanyanın mektubu bir gece daha çekmecede bekleyecek."
        },
        {
          "text": "Halil Efendi mektubu okuyup sobaya atacak. Kayıkların vaktini bir sonraki mektupta yazacak."
        }
      ]
    }
