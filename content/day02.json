      "recipient": "Levazım Kâtibi Halil Efendi",
      "from": "İstanbul, Galata",
      "to": "Çanakkale, Kilitbahir",
      "direction": "cepheye",
      "kind": "mektup",
      "hand": "clerical",
      "letterhead": "ŞARK TİCARET KUMPANYASI · GALATA",
      "dateLine": "4 Mayıs 1331",
      "heading": "Muhterem Efendim,",
      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Geçen hafta gönderilen incirlerin bir kısmı yolda ıslanmış, hasarlı ulaşmıştır."
        },
        {
          "id": "s2",
          "kind": "normal",
          "text": "Yeni sevkiyat için kayıkların vakti tarafınızdan tez elden bildirilmelidir."
        },
        {
          "id": "s3",
          "kind": "normal",
          "text": "Bedeli bir evvelki gibi malum mahalde ödenecektir."
        },
        {
          "id": "s4",
          "kind": "normal",
          "text": "Hürmetlerimizle efendim."
        }
      ],
      "seal": {
        "legend": "ŞARK TİCARRET · GALATA",
        "color": "#5b2e4a",
        "symbol": "anchor",
        "double": true
      },
      "inspectables": [
        {
