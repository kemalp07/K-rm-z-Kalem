          "target": "seal",
          "anomaly": true,
          "note": "Halkadaki yazıda bir harf fazla: TİCARRET. Bir kumpanya kendi adını yanlış kazdırmaz."
        },
        {
          "id": "date",
          "target": "date",
          "note": "4 Mayıs 1331. Dört gün evvel."
        }
      ],
      "reasons": [
