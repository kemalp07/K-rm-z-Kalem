              "d1_mehmet:reported"
            ]
          },
          "text": "Mehmet'in mektubu Şube'ye gitti. Neden gittiğini Mehmet hiç öğrenmeyecek."
        },
        {
          "when": {
            "all": [
              "d1_mehmet:stopped"
            ]
          },
          "text": "Hatice Hanım bu hafta da postacının yolunu gözleyecek."
        },
        {
          "when": {
            "all": [
              "d1_mehmet:held"
            ]
          },
          "text": "Mehmet'in mektubu bir gece daha çekmecede bekleyecek."
        },
        {
          "when": {
            "all": [
              "d1_mehmet:delivered",
              "d1_mehmet:censored"
            ]
          },
          "text": "Hatice Hanım oğlundan kısa bir mektup alacak."
        },
        {
          "text": "Hatice Hanım oğlunun mektubunu komşuya okutacak."
        }
