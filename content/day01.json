      "heading": "Muhterem validem,",
      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Evvela ellerinizden öperim. Yolladığınız yün çorapları aldım, ayaklarım ilk defa kuru, Allah razı olsun."
        },
        {
          "id": "s2",
          "kind": "normal",
          "text": "Burada havalar ısındı, sinek pek çok. Biz eyiyiz, merak etmeyesiniz."
        },
        {
          "id": "s3",
          "kind": "sensitive",
          "text": "Bizi yine şimal tarafındaki sırta, ikinci hatta aldılar."
        },
        {
          "id": "s5",
          "kind": "normal",
          "text": "Pederime selam söyleyin. Bağı bu sene kim budayacak, aklım oradadır."
        },
        {
          "id": "s6",
          "kind": "normal",
          "text": "Ayşe'nin gözlerinden öperim. Duanızı eksik etmeyiniz."
        }
      ],
      "signature": "Oğlunuz Mehmet",
      "inspectables": [
        {
          "id": "date",
          "target": "date",
          "note": "Tarih kurşun kalemle atılmış, sonra üstünden mürekkeple geçilmiş. Siperde mürekkep bulmak kolay değil."
        }
      ],
      "marks": [
