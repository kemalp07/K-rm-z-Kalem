      "heading": "Gözümün nuru Mehmet'im,",
      "segments": [
        {
          "id": "s1",
          "kind": "sensitive",
          "text": "Babanın mevlidini okuttuk; köyün yarısı geldi, helvasını komşular kavurdu."
        },
        {
          "id": "s2",
          "kind": "normal",
          "text": "Ayşe senin için bir mendil işledi, bu mektuba koyamadık, kâğıt ince."
        },
        {
          "id": "s3",
          "kind": "sensitive",
          "text": "Köyde un kalmadı, değirmen durdu; jandarma ambardaki buğdayı da yazıp götürdü."
        },
        {
          "id": "s4",
          "kind": "normal",
          "text": "Bağı Osman budadı, bu sene üzüm bol olacak inşallah."
        },
        {
          "id": "s5",
          "kind": "normal",
          "text": "Soğuk sudan sakın, yün çoraplarını giy."
        }
      ],
      "signature": "Anan Hatice",
      "reasons": [
        "moral"
      ],
      "outcomes": [
        {
          "when": {
            "all": [
              "d3_hatice:reported"
            ]
          },
          "text": "Bir ananın mektubu Şube'ye gitti. İçinde bir köyün açlığından başka bir şey yoktu."
        },
        {
          "when": {
            "all": [
              "d3_hatice:stopped"
            ]
          },
          "text": "Mehmet bu hafta da evden haber alamayacak."
        },
        {
          "when": {
            "all": [
              "d3_hatice:held"
            ]
          },
          "text": "Hatice Hanım'ın mektubu bir gece daha çekmecede bekleyecek."
