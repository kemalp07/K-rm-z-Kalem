      "heading": "Aziz Nuri'm,",
      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Fesleğenleri pencerenin önüne dizdim, sizin sevdiğiniz gibi."
        },
        {
          "id": "s2",
          "kind": "normal",
          "text": "Evde herkes sizi soruyor; valideniz her mektubunuzu üç kere okutuyor."
        },
        {
          "id": "s3",
          "kind": "normal",
          "text": "Nişan yüzüğümü bir an olsun parmağımdan çıkarmıyorum."
        },
        {
          "id": "s4",
          "kind": "normal",
          "text": "Ellerimle bir mendil işledim, köşesine adınızı yazdım."
        },
        {
          "id": "s5",
          "kind": "normal",
          "text": "Rüyamda sizi gördüm, iskelede bekliyordunuz."
        },
        {
          "id": "s6",
          "kind": "normal",
          "text": "Tez vakitte cevap yazınız, gözüm yoldadır."
        }
      ],
      "signature": "Saadet",
      "marks": [
        {
          "kind": "jasmine"
        }
