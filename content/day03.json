      "heading": "Refikam Emine'ye,",
      "segments": [
        {
          "id": "s1",
          "kind": "normal",
          "text": "Hasan yazıyor, ben söylüyorum. Evvela selam eder, çocukların gözlerinden öperim."
        },
        {
          "id": "s2",
          "kind": "sensitive",
          "text": "İshal geçti sanıyordum, yine tuttu; iki gündür çadırda yatıyorum."
        },
        {
          "id": "s3",
          "kind": "normal",
          "text": "Kerim Ağa'ya söyle, duvar parasını ben gelince öderim, borca yazmasın."
        },
        {
          "id": "s4",
          "kind": "normal",
          "text": "Hasan da selam ediyor, onun anası da Eyüp'te, bir uğrayıver."
        },
        {
          "id": "s5",
          "kind": "hiddenInk",
          "text": "çarşamba · erzak iskelesi · fener ikinci",
          "revealBy": "mum",
          "place": "foot"
        },
        {
          "id": "s6",
          "kind": "normal",
          "text": "Sen dua et, gerisi Allah'ın."
        }
      ],
      "signature": "Rıza — Hasan eliyle",
      "marks": [
        {
          "kind": "thumb",
          "near": "s2"
        }
      ],
      "reasons": [
        "askeri",
        "gizli"
      ],
      "outcomes": [
        {
          "when": {
            "all": [
              "d3_riza:reported",
              "d3_riza:revealed:s5"
            ]
          },
          "text": "Şube imzanın altındaki satırı okudu. Çarşamba gecesi erzak iskelesine fazladan nöbetçi konacak."
        },
        {
          "when": {
            "all": [
              "d3_riza:reported"
            ]
          },
          "text": "Rıza'nın mektubu Şube'ye gitti. İmzanın altında ne yazdığını kimse bilmiyor; Rıza da bilmiyor."
        },
        {
          "when": {
            "all": [
              "d3_riza:stopped"
            ]
          },
          "text": "Emine bu hafta Rıza'dan haber alamayacak."
        },
        {
          "when": {
            "all": [
              "d3_riza:held"
            ]
          },
          "text": "Rıza'nın sözleri bir gece daha çekmecede bekleyecek."
        },
        {
          "when": {
            "all": [
              "d3_riza:delivered",
              "d3_riza:revealed:s5"
            ]
          },
          "text": "İmzanın altındaki satırı gördün ve geçirdin. Mektup Eyüp'e, satır başka birine gidecek."
        },
        {
          "when": {
            "all": [
              "d3_riza:delivered",
              "d3_riza:censored:s2"
            ]
          },
          "text": "Emine kocasının hasta olduğunu bilmeyecek. İmzanın altındaki boşluğa kimse bakmayacak."
        },
        {
          "text": "Emine mektubu imama okutacak. İmzanın altında bir şey olduğunu kimse fark etmeyecek."
        }
      ]
    },
    {
